# Copy to .env and adjust. Values below match docker-compose.yml.
# connection_limit: how many database connections the API keeps open (Prisma default is small).
# max_idle_connection_lifetime: close connections idle for 20 s, before proxies/NATs silently drop them.
# connect_timeout / socket_timeout: give up on a dead connection quickly instead of hanging.
DATABASE_URL="postgresql://skyvoyage:skyvoyage@127.0.0.1:5432/skyvoyage?schema=public&connection_limit=20&max_idle_connection_lifetime=20&connect_timeout=10&socket_timeout=15"
# Leave empty to use the in-memory seat-hold store (single server only).
REDIS_URL="redis://127.0.0.1:6379"
PORT=4000
# Use long random strings in production, e.g. `node -e "console.log(crypto.randomBytes(48).toString('hex'))"`
JWT_ACCESS_SECRET="change-me-access"
JWT_REFRESH_SECRET="change-me-refresh"
CLIENT_ORIGIN="http://localhost:5173"
# The account registered with this email becomes an admin.
ADMIN_EMAIL="admin@skyvoyage.example"
